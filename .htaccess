<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable directory slash redirect by mod_dir to prevent URL exposure
    DirectorySlash Off

    # Direct everything into laravel-app/public silently
    RewriteCond %{REQUEST_URI} !^/laravel-app/public/
    RewriteRule ^(.*)$ laravel-app/public/$1 [L]
</IfModule>