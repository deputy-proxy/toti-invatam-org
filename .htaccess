<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect external requests containing /laravel-app/public to the clean URL
    RewriteCond %{THE_REQUEST} /laravel-app/public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,R=301]

    # Internally rewrite root requests to the public folder
    RewriteCond %{REQUEST_URI} !^/laravel-app/public/
    RewriteRule ^(.*)$ laravel-app/public/$1 [L]
</IfModule>