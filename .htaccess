<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to /laravel-app/public in the browser URL
    RewriteCond %{THE_REQUEST} /laravel-app/public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,R=301]

    # Serve static assets directly if they exist in public_html/
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests internally to laravel-app/public/index.php
    RewriteRule ^(.*)$ laravel-app/public/$1 [L]
</IfModule>