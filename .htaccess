<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Check if request is not already pointing to public/
    RewriteCond %{REQUEST_URI} !^/laravel-app/public/

    # Direct all incoming traffic directly to index.php inside laravel-app/public
    RewriteRule ^(.*)$ laravel-app/public/index.php/$1 [L]
</IfModule>