<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent looping by stopping if we are already inside /laravel-app/public
    RewriteCond %{REQUEST_URI} !^/laravel-app/public/

    # Direct all requests to the subfolder's public index.php
    RewriteRule ^(.*)$ laravel-app/public/$1 [L]
</IfModule>